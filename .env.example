# Copie ce fichier en .env.local pour tester en local (ne pas committer)
# En production, configure ces valeurs dans GitHub → Settings → Secrets and variables → Actions

# === SOURCE À SURVEILLER ===
TICKETCORNER_URL=https://www.ticketcorner.ch/event/REMPLACE-MOI
EVENT_LABEL=David Guetta — Venoge Festival

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# === CALLMEBOT WHATSAPP (numéro 1) ===
# Format : indicatif + numéro sans + ni espaces (ex: 41791234567)
CALLMEBOT_PHONE=41791234567
CALLMEBOT_APIKEY=1234567

# === CALLMEBOT WHATSAPP (numéro 2, optionnel) ===
CALLMEBOT_PHONE_2=
CALLMEBOT_APIKEY_2=

# === TWILIO (optionnel, pour vrai appel téléphonique) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
TWILIO_TO_NUMBER_2=
